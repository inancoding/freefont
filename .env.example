# ============================
# 环境变量配置模板
# 复制为 .env.development 或 .env.production 后填写
# ============================

# 服务端口（默认 3001）
PORT=3001

# JWT 密钥（生产环境必须更换为随机长字符串，可用 openssl rand -hex 32 生成）
JWT_SECRET=your-secret-here

# 管理员账号密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# GitHub 配置（字体 ZIP 自动推送到此仓库）
# Token 需要 repo 权限：Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=ghp_xxxxx
GITHUB_OWNER=你的GitHub用户名
GITHUB_REPO=仓库名
