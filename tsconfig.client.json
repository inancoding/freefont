{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@client/*": ["./src/client/*"],
      "@admin/*": ["./src/admin/*"]
    }
  },
  "include": [
    "src/shared/**/*.ts",
    "src/client/**/*.ts",
    "src/client/**/*.vue",
    "src/admin/**/*.ts",
    "src/admin/**/*.vue",
    "src/env.d.ts"
  ]
}
